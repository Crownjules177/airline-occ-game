{
  "name": "bridging-agent",
  "version": "0.1.0",
  "private": true,
  "description": "An AI that helps a group surface what each person wants and can offer, find agreement, form teams and keep momentum. First template: a community meal share.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "vercel-build": "tsx scripts/migrate.ts && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4",
    "typescript": "^5.9",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
