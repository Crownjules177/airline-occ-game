# Postgres connection string. Leave empty to use an embedded PGlite database in ./.data (local dev).
# For the pilot, point this at a Postgres in an Australian region (e.g. Supabase ap-southeast-2).
DATABASE_URL=

# Claude API key. Leave empty to run with the deterministic mock agent (no API calls, no cost).
ANTHROPIC_API_KEY=
# Model used for every agent call (single service layer, NFR6).
BRIDGING_MODEL=claude-opus-5

# Public base URL, used in magic links, invite links and calendar feeds.
APP_URL=http://localhost:3000

# Email delivery for magic links (phase 2). Without it, links are shown on screen in development
# and hosts share sign-in links over WhatsApp.
RESEND_API_KEY=
EMAIL_FROM="Bridging Agent <noreply@example.org>"
